# Anthropic (Ticket 0.5 — AI client)
ANTHROPIC_API_KEY=

# Supabase (Ticket 0.4 / Ticket 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ticket 1 — comma-separated allowlist
# Exact emails and/or domains: teacher@school.org,@school.org
ALLOWED_TEACHER_EMAILS=

# Google OAuth — same Client ID/Secret as Supabase dashboard
# (Authentication → Providers → Google). Also required here so Sebastian
# can refresh Drive provider tokens (Supabase does not refresh them).
# Put real values in .env.local only — never commit secrets here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# In Google Cloud Console → OAuth consent → Data Access, include scope:
# https://www.googleapis.com/auth/drive.file
#
# Drive uploads (SCRUM-87): Sebastian auto-creates a "Sebastian" folder in
# the teacher's My Drive on first successful finalize upload.
